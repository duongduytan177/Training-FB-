FUNCTION_BLOCK "SL_valve"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool;
      Interlock : Bool;
      Auto : Bool;
      Manual : Bool;
      Rest : Bool;
      Stop : Bool;
      Run : Bool;
      OpenCmd : Bool;   // Tin hieu gui tu khoi ben ngoai
      CloseCmd : Bool;   // Tin hieu gui tu khoi ben ngoai
      Button_Open : Bool;   // Nut nhan mo 
      Button_Close : Bool;   // Nut nhan dong 
      Sensor_open : Bool;   // Cam bien mo
      Sensor_close : Bool;   // Cam bien dong
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;   // Tín hiệu làm interlock cho khối FB khác
      Open : Bool;   // Xuat ra cho relay
      Close : Bool;   // Xuat ra cho relay
      Fault : Bool;   // Loi 
   END_VAR

   VAR 
      Figure { S7_SetPoint := 'False'} : "valve";   // Cac trang thai tin hieu cua van
      LatchFault { S7_SetPoint := 'True'} : Bool;   // Lỗi trung gian
      Stop_state : Bool := true;   // Biến nhớ của nút E-STOP
      TonOpen {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      TonClose {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR


BEGIN
	IF #Rest THEN
	    #Busy := 0;
	    #Open := 0;
	    #Fault := 0;
	    #Figure.FaultClose := 0;
	    #Figure.FaultOpen := 0;
	    #Figure.AutoConflict := 0;
	    #Close := 0;
	    #LatchFault := 0;
	    #Stop_state := 0;
	    #Figure.Auto := 0;
	    #Figure.Manual := 0;
	END_IF;
	
	IF #Run THEN
	    #Stop_state := 0;
	END_IF;
	
	//Emergency stop
	IF #Stop THEN
	    #Stop_state := 1;
	    #Open := 0;
	    #Close := 0;
	    #Figure.AutoOpen := 0;
	    #Figure.AutoClose := 0;
	    #Figure.ManOpen := 0;
	    #Figure.ManClose := 0;
	ELSE
	    //Dieu kien de chay van
	    IF #Enable AND #Interlock THEN
	        #Busy := 1;
	        IF #Auto AND NOT #Manual AND NOT #LatchFault THEN
	            #Figure.Auto := 1;
	            #Figure.Manual := 0;
	            #Figure.ManClose := 0;
	            #Figure.ManOpen := 0;
	        ELSIF #Manual AND NOT #Auto THEN
	            #Figure.Auto := 0;
	            #Figure.Manual := 1;
	            #Figure.AutoClose := 0;
	            #Figure.AutoOpen := 0;
	        END_IF;
	        //relay open
	        IF (#Figure.AutoOpen AND NOT #Figure.FaultOpen AND NOT #Figure.AutoConflict)
	            OR (#Figure.ManOpen AND NOT #Figure.ManClose) THEN
	            #Open := 1;
	            #Figure.Close := 0;
	        ELSE
	            #Open := 0;
	        END_IF;
	        //relay close
	        IF (#Figure.AutoClose AND NOT #Figure.FaultClose AND NOT #Figure.AutoConflict)
	            OR (#Figure.ManClose AND NOT #Figure.ManOpen) THEN
	            #Close := 1;
	            #Figure.Open := 0;
	        ELSE
	            #Close := 0;
	        END_IF;
	    ELSE
	        #Busy := 0;
	        #Figure.Open := 0;
	        #Figure.Close := 0;
	        #Close := 0;
	        #Open := 0;
	        #Figure.AutoOpen := 0;
	        #Figure.AutoClose := 0;
	        #Figure.ManOpen := 0;
	        #Figure.ManClose := 0;
	    END_IF;
	END_IF;
	
	#TonOpen(IN := #Open AND #Figure.Auto AND NOT #Sensor_open,
	         PT := #Figure.TimeOut);
	#TonClose(IN := #Close AND #Figure.Auto AND NOT #Sensor_close,
	          PT := #Figure.TimeOut);
	//Auto mode
	IF #Figure.Auto AND NOT #Figure.Manual AND NOT #Stop_state THEN
	    //valve open
	    IF #OpenCmd AND NOT #CloseCmd THEN
	        #Figure.AutoOpen := 1;
	        IF #TonOpen.Q AND NOT #Sensor_open THEN
	            #Figure.Open := 0;
	            #Figure.FaultOpen := 1;
	        ELSIF NOT #TonOpen.Q AND #Sensor_open THEN
	            #Figure.Open := 1;
	        END_IF;
	    ELSE
	        #Figure.AutoOpen := 0;
	        IF NOT #Sensor_open THEN
	            #Figure.Open := 0;
	        END_IF;
	    END_IF;
	    
	    //vavle close
	    IF #CloseCmd AND NOT #OpenCmd THEN
	        #Figure.AutoClose := 1;
	        IF #TonClose.Q AND NOT #Sensor_close THEN
	            #Figure.Close := 0;
	            #Figure.FaultClose := 1;
	        ELSIF NOT #TonClose.Q AND #Sensor_close THEN
	            #Figure.Close := 1;
	        END_IF;
	    ELSE
	        #Figure.AutoClose := 0;
	        IF NOT #Sensor_close THEN
	            #Figure.Close := 0;
	        END_IF;
	    END_IF;
	    
	    //fault
	    IF #OpenCmd AND #CloseCmd THEN
	        #Figure.AutoConflict := 1;
	    END_IF;
	END_IF;
	
	//Manual mode
	IF #Figure.Manual AND NOT #Figure.Auto AND NOT #Stop_state THEN
	    //valve open
	    #Figure.ManClose := #Button_Close;
	    #Figure.ManOpen := #Button_Open;
	    
	    //valve open
	    IF #Sensor_open THEN
	        #Figure.Open := 1;
	    ELSE
	        #Figure.Open := 0;
	    END_IF;
	    
	    //valve close
	    IF #Sensor_close THEN
	        #Figure.Close := 1;
	    ELSE
	        #Figure.Close := 0;
	    END_IF;
	END_IF;
	
	IF #Figure.FaultClose OR #Figure.FaultOpen OR #Figure.AutoConflict THEN
	    #LatchFault := 1;
	END_IF;
	#Fault := #LatchFault;
	
	
	
END_FUNCTION_BLOCK

