TYPE "valve"
VERSION : 0.1
   STRUCT
      Run : Bool;
      Auto : Bool;
      Manual : Bool;
      TimeOut : Time := T#5s;
      Open : Bool;
      Close : Bool;
      ManOpen : Bool;
      ManClose : Bool;
      AutoOpen : Bool;
      AutoClose : Bool;
      FaultOpen : Bool;
      FaultClose : Bool;
      AutoConflict : Bool;
   END_STRUCT;

END_TYPE

