TYPE "valve_sf"
VERSION : 0.1
   STRUCT
      Run : Bool;
      Auto : Bool;
      Manual : Bool;
      Right : Bool;
      Left : Bool;
      FaultRight : Bool;
      FaultLeft : Bool;
      AutoConflict : Bool;
      TimeOut : Time := T#5s;
      Interlock_fault : Bool;
      button_fault : Bool;
   END_STRUCT;

END_TYPE

