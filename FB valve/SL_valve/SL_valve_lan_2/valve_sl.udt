TYPE "valve_sl"
VERSION : 0.1
   STRUCT
      Run : Bool;
      Auto : Bool;
      Manual : Bool;
      TimeOut : Time := T#5s;
      Open : Bool;
      Close : Bool;
      FaultOpen : Bool;
      FaultClose : Bool;
      AutoConflict : Bool;
      Button_fault : Bool;
      InterLock_fault : Bool;
   END_STRUCT;

END_TYPE

